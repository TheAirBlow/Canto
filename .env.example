# PostgreSQL credentials, used by both the postgres and canto services.
POSTGRES_USER=canto
POSTGRES_PASSWORD=changeme
POSTGRES_DB=canto

# Meilisearch master key, used by both the meilisearch and canto services.
MEILI_MASTER_KEY=changeme

# Set to "true" once served behind HTTPS (e.g. reverse proxy) so session cookies require TLS.
CANTO_AUTH_COOKIE_SECURE=false

# Host port exposed by docker-compose.
FRONTEND_PORT=3000
